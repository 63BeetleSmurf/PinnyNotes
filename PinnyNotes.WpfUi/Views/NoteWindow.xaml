<Window x:Class="PinnyNotes.WpfUi.Views.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:PinnyNotes.WpfUi.ViewModels"
        xmlns:controls="clr-namespace:PinnyNotes.WpfUi.Controls"
        xmlns:titleBarItems="clr-namespace:PinnyNotes.WpfUi.Controls.TitleBarItems"
        mc:Ignorable="d"

        BorderThickness="1"
        Icon="/Images/icon.ico"
        MinHeight="75"
        MinWidth="150"
        ResizeMode="CanResize"
        WindowStyle="None"

        FocusManager.FocusedElement="{Binding ElementName=NoteTextBox}"

        Left="{Binding Note.X}"
        Top="{Binding Note.Y}"
        Width="{Binding Note.Width, Mode=TwoWay}"
        Height="{Binding Note.Height, Mode=TwoWay}"
        AllowsTransparency="{Binding Note.TransparencyEnabled}"
        Opacity="{Binding Note.Opacity}"
        ShowInTaskbar="{Binding Note.ShowInTaskbar}"
        Background="{Binding Note.Background}"
        BorderBrush="{Binding Note.BorderBrush}"
        Topmost="{Binding Note.IsPinned}"

        d:DataContext="{d:DesignInstance Type=vm:NoteViewModel}"
        d:Height="300"
        d:Width="300"
        d:Background="#fffcdd"
        d:BorderBrush="#feea00">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="0"
            UseAeroCaptionButtons="False"
            GlassFrameThickness="0"
            CornerRadius="0"
            ResizeBorderThickness="5"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Show/Hide Title Bar -->
        <Storyboard x:Key="HideTitleBarAnimation">
            <DoubleAnimation Storyboard.TargetName="TitleBarGrid"
                             Storyboard.TargetProperty="Height" 
                             To="0" Duration="0:0:0.2" />
        </Storyboard>
        <Storyboard x:Key="ShowTitleBarAnimation">
            <DoubleAnimation Storyboard.TargetName="TitleBarGrid"
                             Storyboard.TargetProperty="Height" 
                             To="40" Duration="0:0:0.2" />
        </Storyboard>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Grid x:Name="TitleBarGrid"
              Grid.Column="0"
              Grid.Row="0"
              Height="40"
              Background="{Binding Note.TitleGridBackground}"
              d:Background="#fef7b1">

            <!-- Items added dynamically -->

            <!-- Context Menu -->
            <Grid.ContextMenu>
                <ContextMenu Name="TitleBarContextMenu">
                    <MenuItem Header="Save" Click="SaveMenuItem_Click" />
                    <Separator />
                    <MenuItem Header="Reset size" Click="ResetMenuItem_Click" />
                    <Separator />
                    <MenuItem x:Name="NoteColourMenuItem" Header="Colour" />
                    <Separator />
                    <MenuItem Header="Management" Click="ManagementMenuItem_Click" />
                    <MenuItem Header="Settings" Click="SettingsMenuItem_Click" />
                </ContextMenu>
            </Grid.ContextMenu>

        </Grid>

        <!-- Text Box -->
        <Grid Grid.Column="0" Grid.Row="1">
            <controls:NoteTextBoxControl BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="{Binding Note.ContentTextBoxForeground}"
                                         CaretBrush="{Binding Foreground, RelativeSource={RelativeSource Self}}"
                                         FontSize="16"
                                         x:Name="NoteTextBox"
                                         Padding="5,5,5,5"
                                         Text="{Binding Note.Content, UpdateSourceTrigger=PropertyChanged}"

                                         BackgroundSpellCheck="{Binding EditorSettings.CheckSpelling}"
                                         NewLineAtEnd="{Binding EditorSettings.NewLineAtEnd}"
                                         KeepNewLineAtEndVisible="{Binding EditorSettings.KeepNewLineVisible}"
                                         WrapText="{Binding EditorSettings.WrapText}"

                                         StandardFontFamily="{Binding EditorSettings.StandardFontFamily}"
                                         MonoFontFamily="{Binding EditorSettings.MonoFontFamily}"
                                         UseMonoFont="{Binding EditorSettings.UseMonoFont}"

                                         AutoIndent="{Binding EditorSettings.AutoIndent}"
                                         TabSpaces="{Binding EditorSettings.UseSpacesForTab}"
                                         ConvertIndentation="{Binding EditorSettings.ConvertIndentationOnPaste}"
                                         TabWidth="{Binding EditorSettings.TabSpacesWidth}"

                                         CopyAction="{Binding EditorSettings.CopyAction}"
                                         TrimTextOnCopy="{Binding EditorSettings.TrimTextOnCopy}"
                                         CopyAltAction="{Binding EditorSettings.CopyAltAction}"
                                         TrimTextOnAltCopy="{Binding EditorSettings.TrimTextOnAltCopy}"
                                         CopyFallbackAction="{Binding EditorSettings.CopyFallbackAction}"
                                         TrimTextOnFallbackCopy="{Binding EditorSettings.TrimTextOnFallbackCopy}"
                                         CopyAltFallbackAction="{Binding EditorSettings.CopyAltFallbackAction}"
                                         TrimTextOnAltFallbackCopy="{Binding EditorSettings.TrimTextOnAltFallbackCopy}"
                                         AutoCopy="{Binding EditorSettings.CopyOnSelect}"
                                         PasteAction="{Binding EditorSettings.PasteAction}"
                                         TrimTextOnPaste="{Binding EditorSettings.TrimTextOnPaste}"
                                         PasteAltAction="{Binding EditorSettings.PasteAltAction}"
                                         TrimTextOnAltPaste="{Binding EditorSettings.TrimTextOnAltPaste}"
                                         MiddleClickPaste="{Binding EditorSettings.MiddleClickPaste}" />
        </Grid>
    </Grid>
</Window>
