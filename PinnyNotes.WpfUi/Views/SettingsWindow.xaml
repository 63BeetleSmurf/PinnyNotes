<Window x:Class="PinnyNotes.WpfUi.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PinnyNotes.WpfUi.ViewModels"
        xmlns:titleBar="clr-namespace:PinnyNotes.WpfUi.Controls.TitleBar"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        Title="Pinny Notes Settings"
        Width="640"
        Height="480">

    <Grid Margin="5,5,5,5">
        <Grid.Resources>
            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style TargetType="GroupBox" BasedOn="{StaticResource {x:Type GroupBox}}">
                <Setter Property="Margin" Value="16,0,16,0" />
            </Style>
            <Style TargetType="Border">
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="Margin" Value="0,0,0,4" />
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">

            <!-- Application Tab -->
            <TabItem Header="Application">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- Application General Group -->
                        <GroupBox Header="General">
                            <StackPanel>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <CheckBox DockPanel.Dock="Right" IsEnabled="{Binding IsStartWithWindowsEnabled}" IsChecked="{Binding ApplicationSettings.StartWithWindows}" />
                                        <TextBlock Text="Start with Windows"/>
                                    </DockPanel>
                                </Border>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <ComboBox DockPanel.Dock="Right"
                                                  ItemsSource="{Binding StartupBehaviourList, Mode=OneTime}"
                                                  SelectedValuePath="Key"
                                                  DisplayMemberPath="Value"
                                                  SelectedValue="{Binding ApplicationSettings.StartupBehaviour, Mode=TwoWay}" />
                                        <TextBlock Text="Startup behaviour"/>
                                    </DockPanel>
                                </Border>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <ComboBox DockPanel.Dock="Right"
                                                  ItemsSource="{Binding NewInstanceBehaviourList, Mode=OneTime}"
                                                  SelectedValuePath="Key"
                                                  DisplayMemberPath="Value"
                                                  SelectedValue="{Binding ApplicationSettings.NewInstanceBehaviour, Mode=TwoWay}" />
                                        <TextBlock Text="New instance behaviour"/>
                                    </DockPanel>
                                </Border>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding ApplicationSettings.ShowNotifyIcon}" />
                                        <TextBlock Text="Show tray icon"/>
                                    </DockPanel>
                                </Border>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding ApplicationSettings.CheckForUpdates}" />
                                        <TextBlock Text="Check for updates on startup"/>
                                    </DockPanel>
                                </Border>

                            </StackPanel>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Notes Tab -->
            <TabItem Header="Notes">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- Notes General Group -->
                        <GroupBox Header="General">
                            <StackPanel>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <TextBox Width="85" MaxLength="4" Text="{Binding NoteSettings.DefaultWidth}" />
                                            <TextBlock Text=" x " />
                                            <TextBox Width="85" MaxLength="4" Text="{Binding NoteSettings.DefaultHeight}" />
                                        </StackPanel>
                                        <TextBlock Text="Default size (W x H)"/>
                                    </DockPanel>
                                </Border>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <ComboBox DockPanel.Dock="Right"
                                                  ItemsSource="{Binding StartupPositionsList, Mode=OneTime}"
                                                  SelectedValuePath="Key"
                                                  DisplayMemberPath="Value"
                                                  SelectedValue="{Binding NoteSettings.StartupPosition, Mode=TwoWay}" />
                                        <TextBlock Text="Startup position"/>
                                    </DockPanel>
                                </Border>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding NoteSettings.PinnedByDefault}" />
                                        <TextBlock Text="Pinned by default"/>
                                    </DockPanel>
                                </Border>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <ComboBox DockPanel.Dock="Right"
                                                  ItemsSource="{Binding MinimizeModeList, Mode=OneTime}"
                                                  SelectedValuePath="Key"
                                                  DisplayMemberPath="Value"
                                                  SelectedValue="{Binding NoteSettings.MinimizeMode, Mode=TwoWay}" />
                                        <TextBlock Text="Allow notes to be minimized"/>
                                    </DockPanel>
                                </Border>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <ComboBox DockPanel.Dock="Right"
                                                  ItemsSource="{Binding VisibilityModeList, Mode=OneTime}"
                                                  SelectedValuePath="Key"
                                                  DisplayMemberPath="Value"
                                                  SelectedValue="{Binding NoteSettings.VisibilityMode, Mode=TwoWay}" />
                                        <TextBlock Text="Visibility mode"/>
                                    </DockPanel>
                                </Border>

                            </StackPanel>
                        </GroupBox>

                        <!-- Notes Title Bar Group -->
                        <GroupBox Header="Title Bar">
                            <StackPanel>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Vertical">
                                            <StackPanel x:Name="SelectedTitleBarItemsPanel"
                                                        Orientation="Horizontal"
                                                        Width="300"
                                                        Height="40"
                                                        Background="#fef7b1"
                                                        Margin="0,0,0,5"/>
                                            <StackPanel x:Name="AvailableTitleBarItemsPanel"
                                                        Orientation="Horizontal"
                                                        Width="300"
                                                        Height="40"
                                                        Background="#FFFCDD">
                                                <titleBar:TitleBarBorderSpacer x:Name="BaseTitleBarSpacerItem"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Text="Title bar items"/>
                                    </DockPanel>
                                </Border>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding NoteSettings.HideTitleBar}" />
                                        <TextBlock Text="Hide title bar"/>
                                    </DockPanel>
                                </Border>

                            </StackPanel>
                        </GroupBox>

                        <!-- Notes Theme Group -->
                        <GroupBox Header="Theme">
                            <StackPanel>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding NoteSettings.CycleColours}" />
                                        <TextBlock Text="Cycle colours"/>
                                    </DockPanel>
                                </Border>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <ComboBox DockPanel.Dock="Right"
                                                  ItemsSource="{Binding ColourModeList, Mode=OneTime}"
                                                  SelectedValuePath="Key"
                                                  DisplayMemberPath="Value"
                                                  SelectedValue="{Binding NoteSettings.ColourMode, Mode=TwoWay}" />
                                        <TextBlock Text="Colour mode"/>
                                    </DockPanel>
                                </Border>

                            </StackPanel>
                        </GroupBox>

                        <!-- Notes Transparency Group -->
                        <GroupBox Header="Transparency">
                            <StackPanel>

                                <TextBlock Grid.Column="0"
                                           Grid.Row="0"
                                           Grid.ColumnSpan="2"
                                           FontStyle="Italic"
                                           TextWrapping="Wrap"
                                           Text="Transparency will slow performance, though mainly just with initial start-up."/>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <ComboBox DockPanel.Dock="Right"
                                                  ItemsSource="{Binding TransparencyModeList, Mode=OneTime}"
                                                  SelectedValuePath="Key"
                                                  DisplayMemberPath="Value"
                                                  SelectedValue="{Binding NoteSettings.TransparencyMode, Mode=TwoWay}" />
                                        <TextBlock Text="Mode"/>
                                    </DockPanel>
                                </Border>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <CheckBox DockPanel.Dock="Right" IsEnabled="{Binding IsTransparencyEnabled}" IsChecked="{Binding NoteSettings.OpaqueWhenFocused}" />
                                        <TextBlock Text="Opaque when focused"/>
                                    </DockPanel>
                                </Border>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <Slider DockPanel.Dock="Right"
                                                Minimum="0.1"
                                                Maximum="1.0"
                                                TickFrequency="0.1"
                                                IsSnapToTickEnabled="True"
                                                SmallChange="0.1"
                                                LargeChange="0.1"
                                                TickPlacement="BottomRight"
                                                Width="150"
                                                IsEnabled="{Binding IsTransparencyEnabled}"
                                                Value="{Binding NoteSettings.OpaqueValue}" />
                                        <TextBlock Text="Opaque value"/>
                                    </DockPanel>
                                </Border>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <Slider DockPanel.Dock="Right"
                                                Minimum="0.1"
                                                Maximum="1.0"
                                                TickFrequency="0.1"
                                                IsSnapToTickEnabled="True"
                                                SmallChange="0.1"
                                                LargeChange="0.1"
                                                TickPlacement="BottomRight"
                                                Width="150"
                                                IsEnabled="{Binding IsTransparencyEnabled}"
                                                Value="{Binding NoteSettings.TransparentValue}" />
                                        <TextBlock Text="Transparent value"/>
                                    </DockPanel>
                                </Border>

                            </StackPanel>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Editor Tab -->
            <TabItem Header="Editor">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- Editor General Group -->
                        <GroupBox Header="General">
                            <StackPanel>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding EditorSettings.CheckSpelling}" />
                                        <TextBlock Text="Spell checker"/>
                                    </DockPanel>
                                </Border>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding EditorSettings.NewLineAtEnd}" />
                                        <TextBlock Text="New line at end"/>
                                    </DockPanel>
                                </Border>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <CheckBox DockPanel.Dock="Right" IsEnabled="{Binding EditorSettings.NewLineAtEnd}" IsChecked="{Binding EditorSettings.KeepNewLineVisible}" />
                                        <TextBlock Text="Keep new line at end visible"/>
                                    </DockPanel>
                                </Border>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding EditorSettings.WrapText}" />
                                        <TextBlock Text="Wrap text"/>
                                    </DockPanel>
                                </Border>

                            </StackPanel>
                        </GroupBox>

                        <!-- Editor Fonts Group -->
                        <GroupBox Header="Fonts">
                            <StackPanel>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <ComboBox DockPanel.Dock="Right"
                                                  ItemsSource="{Binding FontFamilyList, Mode=OneTime}"
                                                  SelectedValuePath="Key"
                                                  DisplayMemberPath="Value"
                                                  SelectedValue="{Binding EditorSettings.StandardFontFamily, Mode=TwoWay}" />
                                        <TextBlock Text="Standard"/>
                                    </DockPanel>
                                </Border>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <ComboBox DockPanel.Dock="Right"
                                                  ItemsSource="{Binding FontFamilyList, Mode=OneTime}"
                                                  SelectedValuePath="Key"
                                                  DisplayMemberPath="Value"
                                                  SelectedValue="{Binding EditorSettings.MonoFontFamily, Mode=TwoWay}" />
                                        <TextBlock Text="Mono"/>
                                    </DockPanel>
                                </Border>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding EditorSettings.UseMonoFont}" />
                                        <TextBlock Text="Use mono font"/>
                                    </DockPanel>
                                </Border>

                            </StackPanel>
                        </GroupBox>

                        <!-- Editor Indentation Group -->
                        <GroupBox Header="Indentation">
                            <StackPanel>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding EditorSettings.AutoIndent}" />
                                        <TextBlock Text="Auto indent"/>
                                    </DockPanel>
                                </Border>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding EditorSettings.UseSpacesForTab}" />
                                        <TextBlock Text="Use spaces instead of tabs"/>
                                    </DockPanel>
                                </Border>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding EditorSettings.ConvertIndentationOnPaste}" />
                                        <TextBlock Text="Convert indentation in pasted text"/>
                                    </DockPanel>
                                </Border>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <TextBox DockPanel.Dock="Right" Width="75" MaxLength="2" Text="{Binding EditorSettings.TabSpacesWidth}" />
                                        <TextBlock Text="Tab width"/>
                                    </DockPanel>
                                </Border>

                            </StackPanel>
                        </GroupBox>

                        <!-- Editor Copy and Paste Group -->
                        <GroupBox Header="Copy and Paste">
                            <StackPanel>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Right">
                                            <ComboBox ItemsSource="{Binding CopyActionList, Mode=OneTime}"
                                                      SelectedValuePath="Key"
                                                      DisplayMemberPath="Value"
                                                      SelectedValue="{Binding EditorSettings.CopyAction, Mode=TwoWay}" />
                                            <CheckBox Content="Trim text" IsChecked="{Binding EditorSettings.TrimTextOnCopy}" />
                                        </StackPanel>
                                        <TextBlock Text="Copy action" VerticalAlignment="Top"/>
                                    </DockPanel>
                                </Border>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Right">
                                            <ComboBox ItemsSource="{Binding CopyActionList, Mode=OneTime}"
                                                      SelectedValuePath="Key"
                                                      DisplayMemberPath="Value"
                                                      SelectedValue="{Binding EditorSettings.CopyAltAction, Mode=TwoWay}" />
                                            <CheckBox Content="Trim text" IsChecked="{Binding EditorSettings.TrimTextOnAltCopy}" />
                                        </StackPanel>
                                        <TextBlock Text="Copy alt action (Hold Shift)" VerticalAlignment="Top"/>
                                    </DockPanel>
                                </Border>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Right">
                                            <ComboBox ItemsSource="{Binding CopyFallbackActionList, Mode=OneTime}"
                                                      SelectedValuePath="Key"
                                                      DisplayMemberPath="Value"
                                                      SelectedValue="{Binding EditorSettings.CopyFallbackAction, Mode=TwoWay}" />
                                            <CheckBox Content="Trim text" IsChecked="{Binding EditorSettings.TrimTextOnFallbackCopy}" />
                                        </StackPanel>
                                        <TextBlock Text="Copy fallback action" VerticalAlignment="Top"/>
                                    </DockPanel>
                                </Border>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Right">
                                            <ComboBox ItemsSource="{Binding CopyFallbackActionList, Mode=OneTime}"
                                                      SelectedValuePath="Key"
                                                      DisplayMemberPath="Value"
                                                      SelectedValue="{Binding EditorSettings.CopyAltFallbackAction, Mode=TwoWay}" />
                                            <CheckBox Content="Trim text" IsChecked="{Binding EditorSettings.TrimTextOnAltFallbackCopy}" />
                                        </StackPanel>
                                        <TextBlock Text="Copy alt fallback action" VerticalAlignment="Top"/>
                                    </DockPanel>
                                </Border>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding EditorSettings.CopyOnSelect}" />
                                        <TextBlock Text="Auto copy"/>
                                    </DockPanel>
                                </Border>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Right">
                                            <ComboBox ItemsSource="{Binding PasteActionList, Mode=OneTime}"
                                                      SelectedValuePath="Key"
                                                      DisplayMemberPath="Value"
                                                      SelectedValue="{Binding EditorSettings.PasteAction, Mode=TwoWay}" />
                                            <CheckBox Content="Trim text" IsChecked="{Binding EditorSettings.TrimTextOnPaste}" />
                                        </StackPanel>
                                        <TextBlock Text="Paste action" VerticalAlignment="Top"/>
                                    </DockPanel>
                                </Border>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Right">
                                            <ComboBox ItemsSource="{Binding PasteActionList, Mode=OneTime}"
                                                      SelectedValuePath="Key"
                                                      DisplayMemberPath="Value"
                                                      SelectedValue="{Binding EditorSettings.PasteAltAction, Mode=TwoWay}" />
                                            <CheckBox Content="Trim text" IsChecked="{Binding EditorSettings.TrimTextOnAltPaste}" />
                                        </StackPanel>
                                        <TextBlock Text="Paste alt action (Hold shift)" VerticalAlignment="Top"/>
                                    </DockPanel>
                                </Border>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding EditorSettings.MiddleClickPaste}" />
                                        <TextBlock Text="Middle click paste"/>
                                    </DockPanel>
                                </Border>

                            </StackPanel>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Tools">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <Border>
                            <DockPanel LastChildFill="True">
                                <ComboBox DockPanel.Dock="Right"
                                          ItemsSource="{Binding ToolStateList, Mode=OneTime}"
                                          SelectedValuePath="Key"
                                          DisplayMemberPath="Value"
                                          SelectedValue="{Binding ToolSettings.Base64ToolState, Mode=TwoWay}" />
                                <TextBlock Text="Base 64"/>
                            </DockPanel>
                        </Border>

                        <Border>
                            <DockPanel LastChildFill="True">
                                <ComboBox DockPanel.Dock="Right"
                                          ItemsSource="{Binding ToolStateList, Mode=OneTime}"
                                          SelectedValuePath="Key"
                                          DisplayMemberPath="Value"
                                          SelectedValue="{Binding ToolSettings.BracketToolState, Mode=TwoWay}" />
                                <TextBlock Text="Bracket"/>
                            </DockPanel>
                        </Border>

                        <Border>
                            <DockPanel LastChildFill="True">
                                <ComboBox DockPanel.Dock="Right"
                                          ItemsSource="{Binding ToolStateList, Mode=OneTime}"
                                          SelectedValuePath="Key"
                                          DisplayMemberPath="Value"
                                          SelectedValue="{Binding ToolSettings.CaseToolState, Mode=TwoWay}" />
                                <TextBlock Text="Case"/>
                            </DockPanel>
                        </Border>

                        <Border>
                            <DockPanel LastChildFill="True">
                                <ComboBox DockPanel.Dock="Right"
                                          ItemsSource="{Binding ToolStateList, Mode=OneTime}"
                                          SelectedValuePath="Key"
                                          DisplayMemberPath="Value"
                                          SelectedValue="{Binding ToolSettings.ColourToolState, Mode=TwoWay}" />
                                <TextBlock Text="Colour"/>
                            </DockPanel>
                        </Border>

                        <Border>
                            <DockPanel LastChildFill="True">
                                <ComboBox DockPanel.Dock="Right"
                                          ItemsSource="{Binding ToolStateList, Mode=OneTime}"
                                          SelectedValuePath="Key"
                                          DisplayMemberPath="Value"
                                          SelectedValue="{Binding ToolSettings.DateTimeToolState, Mode=TwoWay}" />
                                <TextBlock Text="Date\Time"/>
                            </DockPanel>
                        </Border>

                        <Border>
                            <DockPanel LastChildFill="True">
                                <ComboBox DockPanel.Dock="Right"
                                          ItemsSource="{Binding ToolStateList, Mode=OneTime}"
                                          SelectedValuePath="Key"
                                          DisplayMemberPath="Value"
                                          SelectedValue="{Binding ToolSettings.GibberishToolState, Mode=TwoWay}" />
                                <TextBlock Text="Gibberish"/>
                            </DockPanel>
                        </Border>

                        <Border>
                            <DockPanel LastChildFill="True">
                                <ComboBox DockPanel.Dock="Right"
                                          ItemsSource="{Binding ToolStateList, Mode=OneTime}"
                                          SelectedValuePath="Key"
                                          DisplayMemberPath="Value"
                                          SelectedValue="{Binding ToolSettings.GuidToolState, Mode=TwoWay}" />
                                <TextBlock Text="GUID"/>
                            </DockPanel>
                        </Border>

                        <Border>
                            <DockPanel LastChildFill="True">
                                <ComboBox DockPanel.Dock="Right"
                                          ItemsSource="{Binding ToolStateList, Mode=OneTime}"
                                          SelectedValuePath="Key"
                                          DisplayMemberPath="Value"
                                          SelectedValue="{Binding ToolSettings.HashToolState, Mode=TwoWay}" />
                                <TextBlock Text="Hash"/>
                            </DockPanel>
                        </Border>

                        <Border>
                            <DockPanel LastChildFill="True">
                                <ComboBox DockPanel.Dock="Right"
                                          ItemsSource="{Binding ToolStateList, Mode=OneTime}"
                                          SelectedValuePath="Key"
                                          DisplayMemberPath="Value"
                                          SelectedValue="{Binding ToolSettings.HtmlEntityToolState, Mode=TwoWay}" />
                                <TextBlock Text="HTML entity"/>
                            </DockPanel>
                        </Border>

                        <Border>
                            <DockPanel LastChildFill="True">
                                <ComboBox DockPanel.Dock="Right"
                                          ItemsSource="{Binding ToolStateList, Mode=OneTime}"
                                          SelectedValuePath="Key"
                                          DisplayMemberPath="Value"
                                          SelectedValue="{Binding ToolSettings.IndentToolState, Mode=TwoWay}" />
                                <TextBlock Text="Indent"/>
                            </DockPanel>
                        </Border>

                        <Border>
                            <DockPanel LastChildFill="True">
                                <ComboBox DockPanel.Dock="Right"
                                          ItemsSource="{Binding ToolStateList, Mode=OneTime}"
                                          SelectedValuePath="Key"
                                          DisplayMemberPath="Value"
                                          SelectedValue="{Binding ToolSettings.JoinToolState, Mode=TwoWay}" />
                                <TextBlock Text="Join"/>
                            </DockPanel>
                        </Border>

                        <Border>
                            <DockPanel LastChildFill="True">
                                <ComboBox DockPanel.Dock="Right"
                                          ItemsSource="{Binding ToolStateList, Mode=OneTime}"
                                          SelectedValuePath="Key"
                                          DisplayMemberPath="Value"
                                          SelectedValue="{Binding ToolSettings.JsonToolState, Mode=TwoWay}" />
                                <TextBlock Text="JSON"/>
                            </DockPanel>
                        </Border>

                        <Border>
                            <DockPanel LastChildFill="True">
                                <ComboBox DockPanel.Dock="Right"
                                          ItemsSource="{Binding ToolStateList, Mode=OneTime}"
                                          SelectedValuePath="Key"
                                          DisplayMemberPath="Value"
                                          SelectedValue="{Binding ToolSettings.ListToolState, Mode=TwoWay}" />
                                <TextBlock Text="List"/>
                            </DockPanel>
                        </Border>

                        <Border>
                            <DockPanel LastChildFill="True">
                                <ComboBox DockPanel.Dock="Right"
                                          ItemsSource="{Binding ToolStateList, Mode=OneTime}"
                                          SelectedValuePath="Key"
                                          DisplayMemberPath="Value"
                                          SelectedValue="{Binding ToolSettings.QuoteToolState, Mode=TwoWay}" />
                                <TextBlock Text="Quote"/>
                            </DockPanel>
                        </Border>

                        <Border>
                            <DockPanel LastChildFill="True">
                                <ComboBox DockPanel.Dock="Right"
                                          ItemsSource="{Binding ToolStateList, Mode=OneTime}"
                                          SelectedValuePath="Key"
                                          DisplayMemberPath="Value"
                                          SelectedValue="{Binding ToolSettings.RemoveToolState, Mode=TwoWay}" />
                                <TextBlock Text="Remove"/>
                            </DockPanel>
                        </Border>

                        <Border>
                            <DockPanel LastChildFill="True">
                                <ComboBox DockPanel.Dock="Right"
                                          ItemsSource="{Binding ToolStateList, Mode=OneTime}"
                                          SelectedValuePath="Key"
                                          DisplayMemberPath="Value"
                                          SelectedValue="{Binding ToolSettings.SlashToolState, Mode=TwoWay}" />
                                <TextBlock Text="Slash"/>
                            </DockPanel>
                        </Border>

                        <Border>
                            <DockPanel LastChildFill="True">
                                <ComboBox DockPanel.Dock="Right"
                                          ItemsSource="{Binding ToolStateList, Mode=OneTime}"
                                          SelectedValuePath="Key"
                                          DisplayMemberPath="Value"
                                          SelectedValue="{Binding ToolSettings.SortToolState, Mode=TwoWay}" />
                                <TextBlock Text="Sort"/>
                            </DockPanel>
                        </Border>

                        <Border>
                            <DockPanel LastChildFill="True">
                                <ComboBox DockPanel.Dock="Right"
                                          ItemsSource="{Binding ToolStateList, Mode=OneTime}"
                                          SelectedValuePath="Key"
                                          DisplayMemberPath="Value"
                                          SelectedValue="{Binding ToolSettings.SplitToolState, Mode=TwoWay}" />
                                <TextBlock Text="Split"/>
                            </DockPanel>
                        </Border>

                        <Border>
                            <DockPanel LastChildFill="True">
                                <ComboBox DockPanel.Dock="Right"
                                          ItemsSource="{Binding ToolStateList, Mode=OneTime}"
                                          SelectedValuePath="Key"
                                          DisplayMemberPath="Value"
                                          SelectedValue="{Binding ToolSettings.TrimToolState, Mode=TwoWay}" />
                                <TextBlock Text="Trim"/>
                            </DockPanel>
                        </Border>

                        <Border>
                            <DockPanel LastChildFill="True">
                                <ComboBox DockPanel.Dock="Right"
                                          ItemsSource="{Binding ToolStateList, Mode=OneTime}"
                                          SelectedValuePath="Key"
                                          DisplayMemberPath="Value"
                                          SelectedValue="{Binding ToolSettings.UrlToolState, Mode=TwoWay}" />
                                <TextBlock Text="URL"/>
                            </DockPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

    </Grid>
</Window>
