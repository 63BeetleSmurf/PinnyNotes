<Window x:Class="PinnyNotes.WpfUi.Views.ManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PinnyNotes.WpfUi.Views"
        xmlns:vm="clr-namespace:PinnyNotes.WpfUi.ViewModels"
        mc:Ignorable="d"
        Title="Pinny Notes"
        Width="600"
        Height="400"

        d:DataContext="{d:DesignInstance Type=vm:ManagementViewModel}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ToolBar Grid.Row="0">

            <Button x:Name="NewNoteButton"
                    Width="32"
                    Height="32"
                    ToolTip="New note"
                    Command="{Binding NewNoteCommand}">
                <Button.Template>
                    <ControlTemplate>
                        <Canvas>
                            <Rectangle Width="32" Height="32" Fill="Transparent" />
                            <Path Data="M 4,4 v 24 h 24 V 4 Z M 4, 10 h 24"
                                  Stroke="{DynamicResource TextFillColorTertiaryBrush}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  d:Stroke="#464646">
                            </Path>
                        </Canvas>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button x:Name="SettingsButton"
                    Width="32"
                    Height="32"
                    ToolTip="Settings"
                    Command="{Binding OpenSettingsCommand}">
                <Button.Template>
                    <ControlTemplate>
                        <Canvas>
                            <Rectangle Width="32" Height="32" Fill="Transparent" />
                            <Path Data="M 4,8 h 24 M 8, 4 V 12 M 4,16 h 24 M 24, 12 V 20 M 4,24 h 24 M 16, 20 V 28"
                                  Stroke="{DynamicResource TextFillColorTertiaryBrush}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  d:Stroke="#464646">
                            </Path>
                        </Canvas>
                    </ControlTemplate>
                </Button.Template>
            </Button>

        </ToolBar>

        <ListView x:Name="NotesListView"
                  Grid.Row="1"
                  Margin="5,5,5,5"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  SelectionMode="Extended"
                  ItemsSource="{Binding NotePreviews}">

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Width="125"
                            Height="125"
                            Margin="5"
                            Padding="0,20,0,0"
                            Background="{Binding TitleBrush}"
                            BorderBrush="{Binding BorderBrush}"
                            BorderThickness="1">
                        <TextBlock Text="{Binding ContentPreview}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Padding="5,2,5,2"
                                   Background="{Binding BackgroundBrush}"
                                   Foreground="{Binding TextBrush}" />
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
            
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="IsSelected"
                            Value="{Binding IsSelected, Mode=TwoWay}" />
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext,
                                                   RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="New note"
                              Command="{Binding NewNoteCommand}" />
                    <Separator />
                    <MenuItem Header="Open note(s)"
                              Command="{Binding OpenNotesCommand}" />
                    <MenuItem Header="Close note(s)"
                              Command="{Binding CloseNotesCommand}" />
                    <Separator />
                    <MenuItem Header="Delete note"
                              Command="{Binding DeleteNotesCommand}" />
                </ContextMenu>
            </ListView.ContextMenu>

            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>

        </ListView>

    </Grid>

</Window>
